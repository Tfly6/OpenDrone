<launch>
  <arg name="gazebo_simulation" default="true" />
  <arg name="takeoff_height" default="2.0" />
  <arg name="use_dynamic_reconfigure" default="false" />
  <include file="$(find opendrone)/launch/sitl_pid_controller.launch">
    <arg name="gazebo_simulation" value="$(arg gazebo_simulation)" />
    <arg name="takeoff_height" value="$(arg takeoff_height)" />
    <arg name="use_dynamic_reconfigure" value="$(arg use_dynamic_reconfigure)" />
  </include>
</launch>
