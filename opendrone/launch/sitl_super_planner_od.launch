<launch>
    <arg name="use_mpc" default="false" />
    <arg name="use_preset_waypoints" default="false" />
    <arg name="waypoint_type" default="circle" />
    <arg name="auto_trigger_waypoints" default="false" />
    <arg name="start_from_current_position" default="true" />
    <arg name="odom_topic" default="/mavros/local_position/odom" />
    <arg name="lidar_topic" default="/livox/lidar" />
    <arg name="lidar_frame" default="livox_link" />
    <arg name="super_cfg" default="$(find super_planner_od)/config/click_smooth_px4.yaml" />
    
    <node pkg="tf" type="static_transform_publisher" name="world_map_linker" args="0 0 0 0 0 0 world map 100" />
    <node pkg="tf" type="static_transform_publisher" name="tf_lidar" args="0.07 0 0.072 0 0.3925 0 base_link livox_link 50"/>

    <node pkg="opendrone" name="pointcloud_to_world" type="pointcloud_to_world.py" output="screen">
        <param name="source_topic" value="$(arg lidar_topic)" />
        <param name="output_topic" value="/registered_scan" />
        <param name="source_frame" value="$(arg lidar_frame)" />
        <param name="target_frame" value="world" />
        <param name="cloud_timeout" value="2.0" />
        <param name="filter_enable" value="false" />
    </node>

    <include if="$(arg use_preset_waypoints)" file="$(find waypoint_generator)/launch/waypoint_generator.launch">
        <arg name="odom_topic" value="/mavros/local_position/odom" />
        <arg name="waypoint_type" value="$(arg waypoint_type)" />
        <arg name="auto_trigger" value="$(arg auto_trigger_waypoints)" />
        <arg name="start_from_current_position" value="$(arg start_from_current_position)" />
        <arg name="enable_mission_manager" value="true" />
        <arg name="goal_topic" value="/planning/mission_goal" />
    </include>

    <include file="$(find super_planner_od)/launch/super_planner_od.launch">
        <arg name="config_path" value="$(arg super_cfg)" />
        <arg name="cloud_topic" value="/registered_scan" />
        <arg name="odom_topic" value="$(arg odom_topic)" />
        <arg name="click_goal_topic" value="/goal" />
        <arg name="mission_goal_topic" value="/planning/mission_goal" />
        <arg name="position_command_topic" value="/planning/pos_cmd" />
        <arg name="polynomial_trajectory_topic" value="/planning_cmd/poly_traj" />
        <arg name="use_rviz" value="false" />
    </include>

    <group if="$(arg use_mpc)">
        <node pkg="opendrone" name="planner_adapter" type="planner_adapter.py" output="screen">
            <param name="adapter_type" value="polynomial"/>
            <param name="planner_id" value="super_planner_od"/>
            <param name="planner_family" value="online_planner"/>
            <param name="input_topic" value="/planning_cmd/poly_traj"/>
            <param name="planner_output_topic" value="/planner/output"/>
            <param name="publish_horizon_on_timer" value="true"/>
            <param name="horizon_points" value="60"/>
            <param name="sample_dt" value="0.02"/>
            <param name="frame_id" value="world"/>
        </node>
    </group>

    <group unless="$(arg use_mpc)">
        <node pkg="opendrone" name="planner_adapter" type="planner_adapter.py" output="screen">
            <param name="adapter_type" value="position_command"/>
            <param name="planner_id" value="super_planner_od"/>
            <param name="planner_family" value="online_planner"/>
            <param name="input_topic" value="/planning/pos_cmd"/>
            <param name="planner_output_topic" value="/planner/output"/>
            <param name="frame_id" value="world"/>
        </node>
    </group>

    <node name="rviz" pkg="rviz" type="rviz" args="-d $(find super_planner_od)/rviz/bench.rviz" required="true" />
</launch>
