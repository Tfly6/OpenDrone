<launch>
    <arg name="publish_horizon_reference" default="false" />
    <arg name="use_preset_waypoints" default="false" />
    <arg name="waypoint_type" default="circle" />
    <arg name="auto_trigger_waypoints" default="false" />
    <arg name="start_from_current_position" default="true" />
    <arg name="use_rviz" default="true" />
    <node pkg="tf" type="static_transform_publisher" name="world_map_linker" args="0 0 0 0 0 0 world map 100" />
    <node pkg="tf" type="static_transform_publisher" name="tf_camera" args="0.1 0 0.0 -1.57 0 -1.57 base_link camera_link 33"/>

    <!-- Camera pose publisher -->
    <!-- This node publishes tf from parent_frame to child_frame-->
    <node pkg="opendrone" name="camera_pose_publisher" type="camera_pose_publisher.py" output="screen">
        <param name="parent_frame" value="world" />
        <param name="child_frame" value="camera_link" />
        <param name="pose_topic" value="camera/pose" />
    </node>

    <include if="$(arg use_preset_waypoints)" file="$(find waypoint_generator)/launch/waypoint_generator.launch">
        <arg name="odom_topic" value="/mavros/local_position/odom" />
        <arg name="waypoint_type" value="$(arg waypoint_type)" />
        <arg name="auto_trigger" value="$(arg auto_trigger_waypoints)" />
        <arg name="start_from_current_position" value="$(arg start_from_current_position)" />
    </include>

    <include file="$(find ego_planner)/launch/single_run_in_sim.launch">
        <arg name="config_file" value="$(find ego_planner)/config/depth.yaml"/>
        <arg name="camera_pose_topic" value="/camera/pose"/>
        <arg name="depth_topic" default="/camera/depth/image_raw"/>
        <!-- <arg name="depth_topic" default="/iris/camera/depth/image_raw"/> -->
        <arg name="odom_topic" value="/mavros/local_position/odom"/>
        <!-- <arg name="obstacles_inflation" value="0.25" /> -->
        <!-- <arg name="debug_map" default="false"/>
        <arg name="debug_fsm" default="false"/>
        <arg name="debug_planner" default="false"/>
        <arg name="debug_astar" default="false"/> -->
    </include>

    <!-- 发布时间对齐的前瞻参考时 -->
    <group if="$(arg publish_horizon_reference)">
        <node pkg="opendrone" name="planner_adapter" type="planner_adapter.py" output="screen">
            <param name="adapter_type" value="bspline"/>
            <param name="input_topic" value="/drone_0_planning/bspline"/>
            <param name="planner_output_topic" value="/planner/output"/>
            <param name="position_command_topic" value="/drone_0_planning/pos_cmd"/>
            <param name="publish_horizon_on_timer" value="true"/>
            <param name="horizon_points" value="60"/>
            <param name="sample_dt" value="0.02"/>
            <param name="frame_id" value="world"/>
        </node>
    </group>

    <!-- 发布当前位置单点参考时 -->
    <group unless="$(arg publish_horizon_reference)">
        <node pkg="opendrone" name="planner_adapter" type="planner_adapter.py" output="screen">
            <param name="adapter_type" value="position_command"/>
            <param name="input_topic" value="/drone_0_planning/pos_cmd"/>
            <param name="planner_output_topic" value="/planner/output"/>
            <param name="frame_id" value="world"/>
        </node>
    </group>
    
    <!-- rviz -->
    <!-- <node name="rviz" pkg="rviz" type="rviz" args="-d $(find opendrone)/rviz/rviz_ego.rviz" required="true" /> -->
    <node if="$(arg use_rviz)" name="rviz" pkg="rviz" type="rviz" args="-d $(find opendrone)/rviz/ego_planner.rviz" required="true" />
</launch>
