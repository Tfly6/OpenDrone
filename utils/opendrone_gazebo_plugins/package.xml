<?xml version="1.0"?>
<package format="2">
  <name>opendrone_gazebo_plugins</name>
  <version>0.1.0</version>
  <description>
    Lightweight Gazebo Classic contact filtering and ROS event reporting for OpenDrone.
  </description>

  <maintainer email="2085488186@qq.com">OpenDrone maintainers</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>message_generation</build_depend>
  <build_depend>gazebo_dev</build_depend>
  <depend>roscpp</depend>
  <depend>std_msgs</depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>message_runtime</exec_depend>

  <export>
    <gazebo_ros plugin_path="${prefix}/../../lib"/>
  </export>
</package>
